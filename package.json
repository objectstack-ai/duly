{
  "name": "duly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Duly — the ObjectStack template app for recurring duties: define once, dispatch every period, see the state of play without asking.",
  "keywords": [
    "objectstack",
    "template",
    "recurring-duties",
    "compliance-calendar",
    "obligation-management"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "dev": "objectstack dev --compile",
    "demo": "node scripts/demo.mjs",
    "demo:zh": "DULY_DEMO_LOCALE=zh-CN node scripts/demo.mjs",
    "start": "objectstack start",
    "build": "objectstack build",
    "validate": "objectstack validate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify": "pnpm validate && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@objectstack/spec": "^18.1.0",
    "@objectstack/runtime": "^18.1.0",
    "@objectstack/plugin-hono-server": "^18.1.0",
    "@objectstack/connector-rest": "^18.1.0",
    "@objectstack/connector-openapi": "^18.1.0",
    "@objectstack/connector-mcp": "^18.1.0"
  },
  "devDependencies": {
    "@objectstack/cli": "^18.1.0",
    "@objectstack/platform-objects": "^18.1.0",
    "@objectstack/plugin-auth": "^18.1.0",
    "@objectstack/plugin-email": "^18.1.0",
    "@objectstack/plugin-security": "^18.1.0",
    "@objectstack/plugin-sharing": "^18.1.0",
    "@objectstack/service-automation": "^18.1.0",
    "@objectstack/service-job": "^18.1.0",
    "@objectstack/service-messaging": "^18.1.0",
    "@objectstack/trigger-schedule": "^18.1.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
